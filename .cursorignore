# Ignore files that should not be included in Cursor's project context

# Environment and secrets files
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Dependency directories
node_modules/
vendor/
venv/
.venv/
__pycache__/
*.pyc

# Build output
dist/
build/
out/

# OS / editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
